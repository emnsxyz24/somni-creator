# Somni Creator - Backend Environment Variables
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/somni_creator?schema=public"

# Authentication & JWT
JWT_ACCESS_SECRET="somni_jwt_access_secret_change_in_production"
JWT_REFRESH_SECRET="somni_jwt_refresh_secret_change_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
