generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  COLLABORATOR
}

enum DealStatus {
  LEAD
  NEGOTIATING
  CONTRACT_SENT
  IN_PROGRESS
  DELIVERED
  INVOICED
  PAID
  LOST
  CANCELLED
}

enum DealSource {
  MANUAL
  AI_EXTRACTED_WEB
  AI_EXTRACTED_TELEGRAM
}

enum DeliverableType {
  TIKTOK
  IG_STORY
  IG_POST
  IG_REEL
  YOUTUBE_SHORT
  YOUTUBE_VIDEO
  OTHER
}

enum DeliverableStatus {
  PENDING
  SUBMITTED
  APPROVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String            @map("password_hash")
  name             String
  role             UserRole          @default(OWNER)
  brands           Brand[]
  deals            Deal[]
  invoices         Invoice[]
  invoiceSequences InvoiceSequence[]
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@map("users")
}

model Brand {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  contactName  String?   @map("contact_name")
  contactEmail String?   @map("contact_email")
  notes        String?   @db.Text
  deals        Deal[]
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  @@index([userId])
  @@map("brands")
}

model Deal {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId       String        @map("brand_id")
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title         String
  status        DealStatus    @default(LEAD)
  valueAmount   BigInt        @map("value_amount")
  valueCurrency String        @default("IDR") @map("value_currency")
  source        DealSource    @default(MANUAL)
  notes         String?       @db.Text
  deliverables  Deliverable[]
  invoice       Invoice?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz

  @@index([userId, status])
  @@index([brandId])
  @@map("deals")
}

model Deliverable {
  id          String            @id @default(uuid())
  dealId      String            @map("deal_id")
  deal        Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type        DeliverableType
  description String?           @db.Text
  dueDate     DateTime          @map("due_date") @db.Date
  status      DeliverableStatus @default(PENDING)
  submittedAt DateTime?         @map("submitted_at") @db.Timestamptz
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@index([dealId])
  @@index([dueDate])
  @@map("deliverables")
}

model Invoice {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId        String        @unique @map("deal_id")
  deal          Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique @map("invoice_number")
  issuedDate    DateTime      @map("issued_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  amount        BigInt
  currency      String        @default("IDR")
  status        InvoiceStatus @default(DRAFT)
  pdfUrl        String?       @map("pdf_url")
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("invoices")
}

model InvoiceSequence {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period     String
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, period])
  @@index([userId, period])
  @@map("invoice_sequences")
}

